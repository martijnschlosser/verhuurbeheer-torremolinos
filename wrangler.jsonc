{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verhuurbeheer-torremolinos",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker/index.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
